{
  "mcpServers": {
    "ruflo": {
      "command": "npx",
      "args": [
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "8",
        "CLAUDE_FLOW_MEMORY_BACKEND": "sqlite",
        "CLAUDE_FLOW_ROUTER_NEURAL": "1",
        "CLAUDE_FLOW_NEURAL_ENABLED": "true",
        "CLAUDE_FLOW_LEARNING_ENABLED": "true"
      },
      "autoStart": false
    },
    "ruv-swarm": {
      "command": "npx",
      "args": [
        "-y",
        "ruv-swarm",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false"
      },
      "optional": true
    },
    "firebase-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-mcp"
      ],
      "optional": true
    }
  }
}