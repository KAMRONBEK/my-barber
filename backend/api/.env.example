# Copy to `.env`, or to `.env.development` / `.env.staging` / `.env.production`.
# Startup loads `.env.${NODE_ENV}` first (NODE_ENV defaults to development), then falls back to `.env`.
#
# Vercel: set the same variable names under Project → Settings → Environment Variables
# for Production, Preview, and Development. For uploads, IAM keys should match each scope where possible.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# -----------------------------------------------------------------------------
# Firebase Admin (Firestore / Auth — required at startup)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_MULTILINE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Optional — omit if your Firebase default bucket is exactly "{FIREBASE_PROJECT_ID}.appspot.com".
# Uncomment when it differs (e.g. "*.firebasestorage.app") so Admin SDK init and legacy HTTPS
# GCS deletes (old avatar URLs still pointing at Firebase Storage) use the correct bucket id.
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=minimum-64-char-strong-random-secret-replace-this-in-production

# -----------------------------------------------------------------------------
# AWS S3 (required for image uploads)
# -----------------------------------------------------------------------------
# Must be a STANDARD S3 bucket, not an S3 Express One Zone ("directory") bucket
# — those are named `<name>--<az-id>--x-s3` and cap presigned URL validity at
# ~5 minutes via CreateSession, regardless of the TTL the API requests. The
# config loader refuses to boot against a bucket name matching that pattern.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA______________
AWS_SECRET_ACCESS_KEY=________________________________
AWS_S3_BUCKET=your-my-barber-uploads

# Optional object key prefix (folder inside the bucket). Not set ⇒ derived from NODE_ENV as "<NODE_ENV>/"
# (e.g. NODE_ENV=development → "development/", production → "production/"). To use bucket root,
# define empty: AWS_S3_PREFIX=
# AWS_S3_PREFIX=staging/

# Presigned GET lifetime for private objects is fixed at 3600 s in code (not configurable via env).

# -----------------------------------------------------------------------------
# Admin API (/admin) — see middleware/adminAuth.ts
# -----------------------------------------------------------------------------
# Production: prefer Firebase Auth ID tokens with custom claim admin: true or role: "admin"
# (set via Firebase Admin SDK). Optional bootstrap / tests / dev:
# ADMIN_UID_ALLOWLIST=firebaseUid1,firebaseUid2
# ADMIN_API_KEY=long-random-secret-for-scripts-only
# ADMIN_UID_ALLOWLIST=
# ADMIN_API_KEY=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Default if unset: NODE_ENV production → https://yourapp.com, else '*'
# CORS_ORIGIN=https://yourapp.com

# Default if unset: production 100, staging 200, otherwise 1000 (per 15 min window — see rate limit middleware)
# RATE_LIMIT_MAX=100

# Optional — Redis URL for shared rate-limit counters (recommended on Vercel so limits apply across serverless instances).
# Without this, express-rate-limit uses in-memory storage per lambda (easy to overrun during client storms).
# Works with standard redis:// or TLS rediss:// (e.g. Upstash).
# REDIS_URL=

# Overrides default `https://${AWS_S3_BUCKET}.s3.${AWS_REGION}.amazonaws.com`
# FILE_URL=https://...

# Expo push notifications
# EXPO_ACCESS_TOKEN=
# Milliseconds before fetching Expo push receipts (default ~15 min); DeviceNotRegistered clears stored tokens.
# Tests use EXPO_RECEIPT_POLL_DELAY_MS=0 (see jest.setup.ts).
# EXPO_RECEIPT_POLL_DELAY_MS=
