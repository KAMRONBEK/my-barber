{
    "name": "my-barber-api",
    "version": "1.0.0",
    "description": "Barber booking API built with Node.js and TypeScript",
    "main": "server.js",
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    },
    "scripts": {
        "prebuild": "node scripts/generate-swagger.js",
        "build": "tsc",
        "start": "tsx server.ts",
        "dev": "dotenv -e .env -- tsx watch server.ts",
        "dev:staging": "dotenv -e .env.staging -- tsx watch server.ts",
        "dev:production": "dotenv -e .env.production -- tsx watch server.ts",
        "start:staging": "dotenv -e .env.staging -- tsx server.ts",
        "start:production": "dotenv -e .env.production -- tsx server.ts",
        "build:staging": "dotenv -e .env.staging -- npm run build",
        "build:production": "dotenv -e .env.production -- npm run build",
        "deploy:staging": "npm run build:staging && npm run start:staging",
        "deploy:production": "npm run build:production && npm run start:production",
        "firebase:deploy:indexes": "npx firebase-tools deploy --only firestore:indexes",
        "lint": "eslint *.ts **/*.ts",
        "lint:fix": "eslint *.ts **/*.ts --fix",
        "format": "prettier --write \"**/*.ts\"",
        "format:check": "prettier --check \"**/*.ts\"",
        "format:lint": "npm run format && npm run lint:fix",
        "test": "jest",
        "vercel-build": "npm run build",
        "vercel:staging": "npm run build && vercel --prod",
        "vercel:production": "npm run build && vercel --prod",
        "vercel:staging:alias": "vercel alias staging-api.my-barber.uz",
        "vercel:production:alias": "vercel alias api.my-barber.uz",
        "deploy:staging:full": "npm run vercel:staging && npm run vercel:staging:alias",
        "deploy:production:full": "npm run vercel:production && npm run vercel:production:alias"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1045.0",
        "@aws-sdk/s3-request-presigner": "^3.1045.0",
        "@upstash/redis": "^1.38.0",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "expo-server-sdk": "^3.7.0",
        "express": "^4.18.2",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^8.5.1",
        "express-validator": "^7.2.1",
        "firebase-admin": "^12.0.0",
        "helmet": "^7.1.0",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "prom-client": "^15.1.0",
        "rate-limit-redis": "^5.0.0",
        "redis": "^4.7.1",
        "sharp": "^0.33.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "uuid": "^9.0.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.10.5",
        "@types/supertest": "^7.2.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "dotenv-cli": "^8.0.0",
        "eslint": "^8.55.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.5.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.1.1",
        "tsx": "^4.6.2",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "barber",
        "booking",
        "api",
        "nodejs",
        "typescript",
        "express",
        "firebase",
        "firestore"
    ],
    "author": "Your Name",
    "license": "MIT",
    "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
