# My Barber Shop — Monorepo Environment Variables
# Copy this file to .env and fill in real values. Never commit .env files.

# ── API (backend/api) ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-min-16-chars

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AWS S3
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web (apps/web) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ── Mobile (apps/mobile) ─────────────────────────────────────────────────────
# Google Maps API key — injected into native AndroidManifest.xml / Info.plist
# at prebuild time via apps/mobile/app.json interpolation.
GOOGLE_API_KEY=
