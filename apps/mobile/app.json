{
  "expo": {
    "name": "My Barber Shop",
    "newArchEnabled": true,
    "slug": "my-barber",
    "scheme": "mybarber",
    "version": "1.0.0",
    "experiments": {
      "typedRoutes": true
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.my-barber.app",
      "appleTeamId": "7BLQ2AA4R3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
    },
    "android": {
      "package": "uz.mybarber.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-image",
      "./plugins/withGoogleMapsApiKey.js"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5d42f48c-712c-4e1a-942d-8bad9510a9ba"
      }
    },
    "owner": "softwhere"
  }
}
