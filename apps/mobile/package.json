    "@my-barber/types": "workspace:*",
    "@my-barber/ui": "workspace:*",
    "@shopify/restyle": "^2.4.5",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.16.1",
    "expo": "~55.0.24",
    "expo-blur": "^55.0.14",
    "expo-constants": "~55.0.16",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "^55.0.10",
    "expo-image-manipulator": "~55.0.18",
    "expo-image-picker": "~55.0.21",
    "expo-linear-gradient": "^55.0.14",
    "expo-linking": "~55.0.15",
    "expo-localization": "^55.0.14",
    "expo-location": "~55.1.10",
    "expo-router": "^55.0.14",
    "expo-secure-store": "^55.0.14",
    "expo-status-bar": "~55.0.6",
    "i18next": "^26.1.0",
    "react": "19.2.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "^2.30.1",
    "react-native-map-link": "^3.13.0",
    "react-native-maps": "1.27.2",
    "react-native-network-logger": "^2.0.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@my-barber/eslint-config": "workspace:*",
    "@my-barber/tsconfig": "workspace:*",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "axios-mock-adapter": "^2.1.0",
    "expo-mcp": "~0.2.1",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.17",
    "react-test-renderer": "19.2.0",
    "reactotron-react-native": "^5.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@gorhom/.*|@shopify/.*))"
